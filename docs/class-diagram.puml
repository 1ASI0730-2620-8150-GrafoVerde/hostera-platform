        RatePlanCommandService ..> IPropertyRepository
        RatePlanQueryService ..> IRatePlanRepository
        RatePlanQueryService ..> IDailyRateRepository
        PropertyQueryService ..> IPropertyRepository

        PropertiesController ..> IPropertyQueryService
        PropertyRoomTypesController ..> IRoomTypeCommandService
        PropertyRoomTypesController ..> IRoomTypeQueryService
        RoomTypesController ..> IRoomTypeCommandService
        RoomTypesController ..> IRoomTypeQueryService
        PropertyRoomsController ..> IRoomCommandService
        PropertyRoomsController ..> IRoomQueryService
        RoomsController ..> IRoomCommandService
        RoomsController ..> IRoomQueryService
        RoomTypesController ..> RoomsActionResultAssembler
        RoomsController ..> RoomsActionResultAssembler
        RoomStatusController ..> IStatusPeriodCommandService
        PropertyStatusPeriodsController ..> IStatusPeriodQueryService
        PropertyRoomAvailabilityController ..> IRoomQueryService
        PropertyRatePlansController ..> IRatePlanCommandService
        PropertyRatePlansController ..> IRatePlanQueryService
        PropertyRatePlansController ..> IPropertyQueryService
        RatePlansController ..> IRatePlanCommandService
        RatePlansController ..> IRatePlanQueryService
        RatePlansController ..> IPropertyQueryService
        PropertyDailyRatesController ..> IRatePlanQueryService
        RoomsContextFacade ..> IRoomQueryService
        RoomsContextFacade ..> IRoomTypeQueryService
        RoomsContextFacade ..> IRatePlanQueryService
        RoomsContextFacade ..> IStatusPeriodQueryService
        RoomsContextFacade ..> IStatusPeriodCommandService
    }

    package "Bookings Bounded Context" as Bookings {
        package "Domain" as BookingsDomain {
            class Booking <<Aggregate>> implements IAuditableEntity {
                +CodePrefix: string = "BKG-"
                +MaxNights: int = 365
                +MaxGuests: int = 12
                +Booking(CreateBookingCommand command, string code, decimal totalAmount)
                +Id: int
                +PropertyId: int
                +Version: int
                +Code: string
                +Status: EBookingStatus
                +GuestName: string
                +GuestEmail: string
                +GuestPhone: string?
                +PreferredLanguage: EPreferredLanguage
                +CheckInDate: DateOnly
                +CheckOutDate: DateOnly
                +Guests: int
                +RoomTypeId: int
                +RoomId: int
                +RatePlanId: int
                +TotalAmount: decimal
                +GuestRequest: string?
                +ConfirmedAt: DateTimeOffset?
                +ConfirmedBy: int?
                +CancelledAt: DateTimeOffset?
                +CancelledBy: int?
                +CancellationReason: ECancellationReason?
                +CancellationNote: string?
                +NoShowAt: DateTimeOffset?
                +NoShowBy: int?
                +CheckedInAt: DateTimeOffset?
                +CheckedInBy: int?
                +GuestDocumentType: EDocumentType?
                +GuestDocumentNumber: string?
                +CheckedOutAt: DateTimeOffset?
                +CheckedOutBy: int?
                +RoomCondition: ERoomCondition?
                +DepartureNote: string?
                +Nights: int
                +LastNight: DateOnly
                +HoldsRoom: bool
                +IsEditable: bool
                +AcceptsPayments: bool
                +AcceptPayment(): void
                +BalanceDue(decimal paidAmount): decimal
                +PaymentStatus(decimal paidAmount): EPaymentStatus
                +CanBeConfirmed: bool
                +CanBeCancelled: bool
                +CanBeMarkedNoShow(DateOnly today): bool
                +CanBeRestored(DateOnly today): bool
                +CanBeCheckedIn(DateOnly today): bool
                +CanBeCheckedOut: bool
                +AllowedTransitions(DateOnly today): IReadOnlyList<EBookingStatus>
                +{static} NextCode(int propertyId, int latestNumber): string
                +{static} NumberOf(string? code): int
                +Overlaps(DateOnly checkInDate, DateOnly checkOutDate): bool
                +HasSamePricingAs(int roomTypeId, int ratePlanId, DateOnly checkInDate, DateOnly checkOutDate): bool
                +Update(UpdateBookingCommand command, decimal totalAmount): void
                +Confirm(DateTimeOffset at, int by): void
                +Cancel(ECancellationReason reason, string? note, DateTimeOffset at, int by): void
                +MarkNoShow(DateOnly today, DateTimeOffset at, int by): void
                +Restore(DateOnly today): void
                +CheckIn(DateOnly today, EDocumentType documentType, string documentNumber, bool documentVerified, DateTimeOffset at, int by): void
                +CheckOut(decimal balanceDue, ERoomCondition roomCondition, string? note, DateTimeOffset at, int by): void
            }

            enum EDocumentType <<ValueObject>> {
                Dni
                Passport
                ForeignResidentCard
            }

            enum ERoomCondition <<ValueObject>> {
                NoIssues
                NeedsAttention
            }

            class CheckInBookingCommand <<record>> {
                +BookingId: int
                +DocumentType: EDocumentType
                +DocumentNumber: string
                +DocumentVerified: bool
                +KeyCardIds: IReadOnlyList<string>
                +OperatorId: int
                +ExpectedVersion: int?
            }

            class CheckOutBookingCommand <<record>> {
                +BookingId: int
                +RoomCondition: ERoomCondition
                +DepartureNote: string?
                +OperatorId: int
                +ExpectedVersion: int?
            }

            class Payment <<Aggregate>> implements IAuditableEntity {
                +MaxReferenceLength: int = 80
                +MaxIdempotencyKeyLength: int = 100
                +Payment(RecordPaymentCommand command, int propertyId)
                +Id: int
                +PropertyId: int
                +BookingId: int
                +Amount: decimal
                +Method: EPaymentMethod
                +PaidAt: DateTimeOffset
                +Reference: string?
                +RecordedBy: int
                +IdempotencyKey: string?
                +Matches(RecordPaymentCommand command): bool
            }

            enum EPaymentMethod <<ValueObject>> {
                Cash
                CardTerminal
                BankTransfer
                Other
            }

            enum EPaymentStatus <<ValueObject>> {
                Unpaid
                PartiallyPaid
                Paid
            }

            class RecordPaymentCommand <<record>> {
                +BookingId: int
                +Amount: decimal
                +Method: EPaymentMethod
                +PaidAt: DateTimeOffset
                +Reference: string?
                +RecordedBy: int
                +IdempotencyKey: string?
                +ExpectedVersion: int?
            }

            interface IPaymentRepository extends IBaseRepository {
                +FindByBookingIdAsync(int bookingId, CancellationToken cancellationToken): Task<IEnumerable<Payment>>
                +FindByPropertyIdAsync(int propertyId, CancellationToken cancellationToken): Task<IEnumerable<Payment>>
                +FindByBookingIdAndIdempotencyKeyAsync(int bookingId, string idempotencyKey, CancellationToken cancellationToken): Task<Payment?>
                +SumAmountsByBookingIdsAsync(IReadOnlyCollection<int> bookingIds, CancellationToken cancellationToken): Task<IReadOnlyDictionary<int, decimal>>
            }

            enum EBookingStatus <<ValueObject>> {
                Pending
                Confirmed
                CheckedIn
                CheckedOut
                Cancelled
                NoShow
            }

            enum ECancellationReason <<ValueObject>> {
                GuestRequest
                ChangeOfPlans
                DuplicateBooking
                PropertyUnable
