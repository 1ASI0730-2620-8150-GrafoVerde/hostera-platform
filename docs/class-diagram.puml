                +PropertyId: int
                +RatePlanId: int
                +RoomTypeId: int
                +Date: DateOnly
                +Amount: decimal
                +ChangeAmount(decimal amount): void
            }

            enum ERecordStatus <<ValueObject>> {
                Active
                Inactive
            }

            enum EOperationalStatus <<ValueObject>> {
                Blocked
                OutOfService
                NeedsCleaning
